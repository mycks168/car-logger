# ── STT/TTS エンジン ──────────────────────────────────────────────
# "openai" または "gateway" を選択
STT_ENGINE=gateway
# "openai" または "voicevox" を選択
TTS_ENGINE=voicevox

# ── OpenAI API（STT_ENGINE=openai または TTS_ENGINE=openai の場合） ──
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.1
OPENAI_TTS_GAIN_DB=9

# ── STT Gateway（STT_ENGINE=gateway の場合） ──────────────────────
# サーバー上で動いている stt-gateway の URL
STT_GATEWAY_URL=http://clove.local:23000
STT_GATEWAY_LANGUAGE=ja

# ── VoiceVox（TTS_ENGINE=voicevox の場合） ───────────────────────
# サーバー上で動いている VoiceVox の URL
VOICEVOX_URL=http://clove.local:50021
VOICEVOX_SPEAKER=2
VOICEVOX_SAMPLE_RATE=48000

# ── TTS フィルター（コードブロックの読み上げ変換など）─────────────
# TTS_FILTER_URL=http://clove.local:9191
# TTS_FILTER_BEARER_TOKEN=
# TTS_FILTER_CODE_BLOCK_MODE=ollama-summary
# TTS_FILTER_OLLAMA_MODEL=qwen2.5:0.5b

# ── OpenClaw LLM ─────────────────────────────────────────────────
OPENCLAW_BASE_URL=http://clove.local:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT_ID=
OPENCLAW_SESSION_KEY=

# 複数セッション（ダブルクリックで切り替え）
# 書式: 名前,agent_id,session_key[,base_url[,token]]
# OPENCLAW_SESSION_1=仕事,abc123,xyz789
# OPENCLAW_SESSION_2=雑談,def456,uvw012

# ── ハードウェア ──────────────────────────────────────────────────
# PTT スイッチの GPIO ピン番号（BCM）
PI3_PTT_GPIO=17

# マイク入力デバイス（arecord -l の card N: <name> の短縮名を使う）
# 例: card 1: Microphone → plughw:CARD=Microphone,DEV=0
AUDIO_DEVICE=plughw:CARD=Microphone,DEV=0

# 音声出力デバイス（aplay -l の card N: <name> の短縮名を使う）
# 例: card 2: vc4hdmi → plughw:CARD=vc4hdmi,DEV=0
AUDIO_OUTPUT_DEVICE=plughw:CARD=vc4hdmi,DEV=0

# amixer 用カード名（AUDIO_OUTPUT_DEVICE の CARD= と同じ値）
AUDIO_OUTPUT_CARD=vc4hdmi

AUDIO_OUTPUT_VOLUME=90
AUDIO_SAMPLE_RATE=16000

# ── HDMI ディスプレイ ─────────────────────────────────────────────
PI3_DISPLAY_WIDTH=1280
PI3_DISPLAY_HEIGHT=720
PI3_DISPLAY_FULLSCREEN=false
PI3_CHAR_SCALE=1.0

# キャラクター画像ディレクトリ
UI_IMAGE_ASSETS_DIR=assets/pngtuber_pi3

# ── Webhook サーバー ─────────────────────────────────────────────
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8080
# WEBHOOK_TOKEN=  # 空なら認証なし

# ── 地図・GPS ────────────────────────────────────────────────────
# gps_server の URL（同一ラズパイ上なら localhost のまま）
GPS_SERVER_URL=http://localhost:8080
# 地図ズームレベル（14=広域 15=町丁目 16=建物）
MAP_ZOOM=15
# タイルキャッシュ保存先
MAP_TILE_CACHE_DIR=/tmp/maptiles

# ── ナビゲーション ───────────────────────────────────────────────
# OSRM 経路計算サーバの URL（サーバ側で ghcr.io/project-osrm/osrm-backend を起動している場合）
OSRM_BASE_URL=http://clove.local:5000

# Overpass API（POI 検索用。デフォルトはパブリックサーバ）
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ターン案内を行う距離（メートル）デフォルト: 300
# NAV_ANNOUNCE_DISTANCE_M=300

# 目的地到着と判定する距離（メートル）デフォルト: 50
# NAV_ARRIVE_DISTANCE_M=50

# POI 検索半径（メートル）デフォルト: 2000
# POI_SEARCH_RADIUS_M=2000

# POI を再検索する移動距離の閾値（メートル）デフォルト: 500
# POI_UPDATE_DISTANCE_M=500

# ── その他 ───────────────────────────────────────────────────────
ENABLE_TTS=true
CONVERSATION_HISTORY_LENGTH=5
SILENCE_RMS_THRESHOLD=200
