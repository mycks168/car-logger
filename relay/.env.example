# ESP32からのPush受信に必要なBearerトークン（ESP32側 config.h の RELAY_PUSH_AUTH_TOKEN と一致させる）
PUSH_AUTH_TOKEN=<change-me>

# 内部サーバ(gps_monitor)からのPull取得に必要なBearerトークン
# （内部サーバ側の .env の GPS_SOURCE_AUTH_TOKEN と一致させる）
PULL_AUTH_TOKEN=<change-me>

# キャッシュした座標を無効化するまでの秒数 デフォルト: 86400（1日）
# CACHE_MAX_AGE_SECONDS=86400

# 直近何秒Pushがなければ「ESP32がオフライン」とみなすか デフォルト: 180
# PUSH_TIMEOUT_SECONDS=180

# バインドアドレス・ポート
# API_HOST=0.0.0.0
# API_PORT=8090
