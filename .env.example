# ============================================================
# サーバ側 (server/.env) で使用する環境変数
# ============================================================

# ラズパイのベースURL（GPS・温度 両方で使用）
RASPI_BASE_URL=http://100.x.x.x:8080

# GPS APIの完全URL（RASPI_BASE_URLから自動生成されるが上書き可）
RASPI_GPS_URL=http://100.x.x.x:8080/gps

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# ポーリング間隔（秒）デフォルト: 60
POLL_INTERVAL_SECONDS=60

# 同一位置でのアラート再通知クールダウン（秒）デフォルト: 1800（30分）
NOTIFY_COOLDOWN_SECONDS=1800

# この距離（メートル）以上移動したら即時再通知 デフォルト: 200
NOTIFY_MOVE_THRESHOLD_M=200

# ラズパイへのリクエストタイムアウト（秒）デフォルト: 15
REQUEST_TIMEOUT_SECONDS=15

# 地図WebUIのポート デフォルト: 8081
# WEB_PORT=8081

# 温度ポーリング間隔（秒）デフォルト: 300（5分）
# TEMP_POLL_INTERVAL_SECONDS=300

# Google Geolocation API キー（未設定の場合はGeolocationをスキップ）
GOOGLE_GEOLOCATION_API_KEY=<your-google-geolocation-api-key>

# Geolocation API 呼び出し間隔（秒）デフォルト: 300（5分）
# GEOLOCATION_INTERVAL_SECONDS=300

# WiFiスキャンに使うインターフェース名 デフォルト: wlan0
# WIFI_IFACE=wlan0

# ============================================================
# ラズパイ側 (raspberry/.env) で使用する環境変数
# ============================================================

# gpsdのホスト・ポート（通常は変更不要）
# GPSD_HOST=localhost
# GPSD_PORT=2947

# APIサーバのバインドアドレス・ポート
# API_HOST=0.0.0.0
# API_PORT=8080

# GPS未取得が続いた場合にキャッシュを無効化するまでの秒数（デフォルト: 86400=1日）
# CACHE_MAX_AGE_SECONDS=86400

# ============================================================
# voice_assistant ナビゲーション設定（raspberry/voice_assistant/.env）
# ============================================================

# OSRM 経路計算サーバの URL（サーバ側で ghcr.io/project-osrm/osrm-backend を起動している場合）
# OSRM_BASE_URL=http://<サーバIP>:5000

# Overpass API URL（POI 検索用、デフォルトはパブリックサーバ）
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ターン案内を行う距離（メートル）デフォルト: 300
# NAV_ANNOUNCE_DISTANCE_M=300

# 目的地到着と判定する距離（メートル）デフォルト: 50
# NAV_ARRIVE_DISTANCE_M=50

# POI 検索半径（メートル）デフォルト: 2000
# POI_SEARCH_RADIUS_M=2000

# POI を再検索する移動距離の閾値（メートル）デフォルト: 500
# POI_UPDATE_DISTANCE_M=500
